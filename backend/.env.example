# =============================================================================
# SmartFactory 360 — Backend Environment Template
# Copy this file to backend/.env and fill in your real values.
# NEVER commit backend/.env (it is listed in .gitignore).
# =============================================================================

# ─── MySQL Database ──────────────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/factory_monitoring?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_64_CHAR_HEX_STRING
JWT_EXPIRY_MS=86400000

# ─── OTP / Twilio SMS ────────────────────────────────────────────────────────
OTP_MODE=DEV
# OTP_MODE=PROD for live Twilio SMS; DEV prints to console only

TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173
