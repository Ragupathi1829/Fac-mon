# =============================================================================
# SmartFactory 360 — Frontend Environment Template
# Copy this file to frontend/.env and fill in your values.
# NEVER commit frontend/.env (it is listed in .gitignore).
# =============================================================================

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:8080/api

# WebSocket endpoint
VITE_WS_URL=ws://localhost:8080/ws/telemetry

# Set to true to use mock data when backend is offline (development only)
# MUST be false in production
VITE_USE_MOCKS=true
